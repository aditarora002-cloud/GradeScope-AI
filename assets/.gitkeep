/* GradeScope AI — dark intelligence console */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');
html, body, [class*="css"] { font-family: 'DM Sans', 'Segoe UI', sans-serif !important; }
[data-testid="stAppViewContainer"] { background: radial-gradient(ellipse 70% 38% at 54% 0%, rgba(80,57,149,.23), transparent 62%), #080D1A; }
[data-testid="stHeader"] {background: transparent;}
[data-testid="stMainBlockContainer"] {max-width: 1340px; padding: 2.0rem 2.3rem 5rem;}
[data-testid="stSidebar"] {background: #0D1423; border-right:1px solid #253149;}
[data-testid="stSidebar"] [data-testid="stVerticalBlock"] {gap: .7rem;}
h1,h2,h3 {font-family:'Manrope','Segoe UI',sans-serif !important; letter-spacing:-.035em !important;}
h1 {font-weight:800 !important;} h2 {font-weight:800 !important;}
p {color: #B7C2D9;}
a {color:#A78BFA!important;}
[data-testid="stMarkdownContainer"] a {text-decoration:none;}
[data-testid="stMetric"] {background:#111B2D; border:1px solid #25324A; border-radius:14px; padding:15px 18px;}
[data-testid="stMetricLabel"] {color:#8D9EBB;}
[data-testid="stMetricValue"] {font-family:'Manrope',sans-serif; font-weight:800;}
[data-testid="stExpander"] {background:#101A2B; border:1px solid #27334B; border-radius:14px;}
[data-testid="stForm"] {background:linear-gradient(180deg,#11192A,#0B1424); border:1px solid #2A3752;border-radius:18px;padding:24px;}
[data-testid="stDataFrame"] {border-radius:12px;overflow:hidden;border:1px solid #253149;}
[data-testid="stPlotlyChart"] {background: #0E1728; border:1px solid #24314A;border-radius:17px;padding:4px;}
div.stButton>button[kind="primary"],div.stFormSubmitButton>button[kind="primary"] {background:linear-gradient(100deg,#7C3AED,#4F46E5);border:1px solid #9F83FF;color:#FFF;border-radius:11px;font-weight:700;letter-spacing:.01em;box-shadow:0 6px 26px #4f46e533;}
div.stButton>button,div.stDownloadButton>button,div.stFormSubmitButton>button {border-radius:11px;border:1px solid #35435E;min-height:43px;}
div[data-testid="stTabs"] button {font-weight:700;}
[data-baseweb="select"]>div,[data-baseweb="input"]>div {background:#101B2E!important;border-radius:9px!important;}
.hero {position:relative; overflow:hidden; border-radius:22px; padding:37px 40px; border:1px solid rgba(159,131,255,.32); background:radial-gradient(circle at 86% 27%,rgba(56,189,248,.22),transparent 35%), linear-gradient(116deg,#19204B,#211541 61%,#11182B);margin:11px 0 23px;}
.hero:after {content:'';position:absolute;border:1px solid rgba(194,177,255,.13);border-radius:50%;height:310px;width:310px;right:-65px;top:-125px;box-shadow:0 0 0 45px rgba(207,196,255,.035),0 0 0 95px rgba(207,196,255,.025);pointer-events:none;}
.hero .eyebrow {color:#C7B8FF;font-weight:800;font-size:11px;letter-spacing:.18em;text-transform:uppercase;margin-bottom:12px;}
.hero h1 {font-size:clamp(27px,3.7vw,43px)!important;line-height:1.18;margin:0 0 13px;color:#FFF;max-width:880px;}
.hero p {font-size:15px;line-height:1.65;color:#C4CBE4;max-width:705px;margin:0;}
.hero .orb {position:absolute;right:105px;bottom:28px;font-size:65px;filter:drop-shadow(0 5px 25px #818cf855);}
@media (max-width:850px) {.hero{padding:27px 21px}.hero .orb{display:none}[data-testid="stMainBlockContainer"]{padding:1.4rem 1rem 4rem}}
.section-label {font-size:12px;letter-spacing:.11em;text-transform:uppercase;font-weight:800;color:#9DAEC9;margin:22px 0 9px;}
.title-row {display:flex;align-items:center;gap:9px;margin-top:19px;margin-bottom:5px;font-size:18px;font-weight:800;color:#F3F5FF;}
.stat-card {background:linear-gradient(150deg,#151F35,#0F1729);border:1px solid #2A3855;border-radius:17px;padding:19px 20px;min-height:128px;box-shadow:0 9px 22px #02050e30;}
.stat-card .tag {color:#AAB8D4;font-size:12px;font-weight:700;letter-spacing:.02em;}
.stat-card .value {font-family:'Manrope',sans-serif;font-size:29px;font-weight:800;letter-spacing:-.04em;color:#F9FAFF;margin-top:12px;}
.stat-card .footer {font-size:11px;color:#8E9DB7;margin-top:4px;}
.tag-pill {display:inline-block;padding:5px 11px;background:#233354;border:1px solid #4C5B7D;border-radius:100px;font-size:11px;font-weight:700;color:#C7D4F2;margin:9px 9px 0 0;}
.tag-pill.purple {background:#382657;border-color:#6C4AA9;color:#D8B4FE;}
.tag-pill.aqua {background:#0E3C4A;border-color:#17697B;color:#67E8F9;}
.tag-pill.amber {background:#47351C;border-color:#80602A;color:#FCD34D;}
.note-card {background:#101C2C;border:1px solid #2A4052;border-left:3px solid #67E8F9;border-radius:12px;padding:17px 19px;color:#C4D1E5;margin:10px 0 18px;font-size:13px;line-height:1.65;}
.prediction-card {border:1px solid #6F52AD;border-radius:20px;padding:26px 28px;background:linear-gradient(125deg,#271D48,#121D38 64%,#0E1829);margin:13px 0 22px;}
.prediction-card .kicker {color:#AD9FCE;letter-spacing:.14em;font-size:11px;font-weight:800;text-transform:uppercase;}
.prediction-card .big {font-size:48px;font-weight:800;font-family:'Manrope',sans-serif;letter-spacing:-.055em;line-height:1.2;color:#FFFFFF;margin:6px 0;}
.prediction-card .subtitle {font-size:14px;color:#BFC8E2;}
.model-ribbon {font-size:12px;color:#A8B6D1;margin:9px 0 19px;}
.sidebar-logo {display:flex;align-items:center;gap:10px;padding:14px 5px 9px;font-family:'Manrope',sans-serif;font-weight:800;font-size:21px;letter-spacing:-.04em;color:white;}
.logo-mark {display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;background:linear-gradient(140deg,#A78BFA,#06B6D4);border-radius:11px;color:white;font-size:21px;box-shadow:0 3px 16px #A78BFA44;}
.mini-title {font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#8493B4;margin-top:22px;}
.footerline {font-size:12px;color:#6C7C99;border-top:1px solid #28334B;padding-top:15px;margin-top:20px;}
.st-key-nav [data-baseweb="radio"]>div {gap:9px;}
.st-key-nav label {background:#0D1728;border:1px solid transparent;border-radius:10px;padding:8px 10px;}
